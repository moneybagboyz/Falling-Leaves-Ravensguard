// The two Phase 4 monsters (anatomy 4.3 and 4.4).
[
// The draugr: the barrow dead. The human plan with dried flesh for skin, fat and muscle, no organs and no vessels; nerves, tendons and
// ligaments are kept, so a cut limb nerve or tendon still disables it. No blood and no pain; it is undone only when its head is severed
// or the skull shattered (or burnt through), or both sides of the ribs are shattered.
{
 "type": "body_plan", "id": "draugr", "name": "Draugr", "copy_from": "human", "size_cm3": 80000, "blood_ml": 0, "blood_ml_per_kg": 0,
 "bleeds": false, "feels_pain": false, "animating_core": "head", "tissue_set": "draugr",
 "tissue_map": { "skin": "dried_flesh", "fat": "dried_flesh", "muscle": "dried_flesh" },
 "drop_organs": true, "drop_structure_kinds": ["artery", "vein"], "tireless": true, "dark_sight": true
},
// The cave beast: a pale, blind-eyed, bear-sized cave predator. Thick hide (8 mm) over fat 20, muscle 80 and bone 25 (head bone 30);
// the throat (4 mm hide) and the eyes are its weak spots. It hunts by ear; it flees below 30% blood unless cornered.
{
 "type": "body_plan", "id": "cave_beast", "name": "Cave beast", "size_cm3": 380000, "blood_ml": 26600, "blood_ml_per_kg": 70, "bleed_scale_pm": 2000,
 "untargetable_pm": 60, "flee_below_blood_pm": 300, "tissue_set": "animal", "dark_sight": true,
 "parts": [
  { "id": "torso", "name": "Torso", "relative_size": 0.5, "depth_mm": 600, "rib_slip": true,
    "layers": [ { "tissue": "hide_thick", "thickness_mm": 8 }, { "tissue": "fat", "thickness_mm": 20 }, { "tissue": "muscle", "thickness_mm": 80 }, { "tissue": "bone_tissue", "thickness_mm": 25 } ],
    "structures": [ { "id": "cord_back", "kind": "spinal_cord", "tissue": "spinal_cord", "area_fraction": 0.02, "facing_pm": { "front": 300, "flank": 800, "rear": 1600 } } ],
    "organs": [
      { "id": "heart", "tissue": "organ", "area_fraction": 0.04, "vital": true, "bleed_ml_per_s": 200 },
      { "id": "lungs", "tissue": "organ", "area_fraction": 0.2, "bleed_ml_per_s": 40 },
      { "id": "liver", "tissue": "organ", "area_fraction": 0.07, "bleed_ml_per_s": 40 } ] },
  { "id": "neck", "name": "Neck", "relative_size": 0.06, "depth_mm": 250, "parent": "torso", "pain_pm": 1300,
    "layers": [ { "tissue": "hide_thick", "thickness_mm": 4 }, { "tissue": "fat", "thickness_mm": 10 }, { "tissue": "muscle", "thickness_mm": 60 }, { "tissue": "bone_tissue", "thickness_mm": 25 } ],
    "structures": [
      { "id": "carotid_artery", "kind": "artery", "tissue": "muscle", "area_fraction": 0.06, "gap_boost": { "throat": 2.0 } },
      { "id": "jugular_vein", "kind": "vein", "tissue": "muscle", "area_fraction": 0.06, "gap_boost": { "throat": 2.0 } },
      { "id": "cord_neck", "kind": "spinal_cord", "tissue": "spinal_cord", "area_fraction": 0.03, "facing_pm": { "front": 600 } } ] },
  { "id": "head", "name": "Head", "relative_size": 0.08, "depth_mm": 350, "parent": "neck",
    "layers": [ { "tissue": "hide_thick", "thickness_mm": 8 }, { "tissue": "fat", "thickness_mm": 5 }, { "tissue": "bone_tissue", "thickness_mm": 30 } ],
    "organs": [ { "id": "brain", "tissue": "organ", "area_fraction": 0.3, "vital": true, "bleed_ml_per_s": 20 } ] },
  { "id": "fore_leg", "name": "Foreleg", "relative_size": 0.07, "depth_mm": 160, "sided": true, "parent": "torso", "severable": true, "limb": "leg",
    "layers": [ { "tissue": "hide_thick", "thickness_mm": 8 }, { "tissue": "fat", "thickness_mm": 10 }, { "tissue": "muscle", "thickness_mm": 60 }, { "tissue": "bone_tissue", "thickness_mm": 25 } ],
    "structures": [ { "id": "fore_artery", "kind": "artery", "tissue": "muscle", "area_fraction": 0.05 }, { "id": "fore_tendon", "kind": "tendon", "tissue": "tendon", "area_fraction": 0.06 } ] },
  { "id": "hind_leg", "name": "Hind leg", "relative_size": 0.08, "depth_mm": 180, "sided": true, "parent": "torso", "severable": true, "limb": "leg",
    "layers": [ { "tissue": "hide_thick", "thickness_mm": 8 }, { "tissue": "fat", "thickness_mm": 12 }, { "tissue": "muscle", "thickness_mm": 70 }, { "tissue": "bone_tissue", "thickness_mm": 25 } ],
    "structures": [ { "id": "hind_artery", "kind": "artery", "tissue": "muscle", "area_fraction": 0.05 }, { "id": "hind_tendon", "kind": "tendon", "tissue": "tendon", "area_fraction": 0.06 } ] },
  { "id": "eye", "name": "Eye", "sided": true, "host": "head", "relative_size": 0.0003, "depth_mm": 15, "area_fraction": 0.01, "aim_factor_pm": 60,
    "layers": [ { "tissue": "organ", "thickness_mm": 15 } ], "function": { "sight_pm": 50 } }
