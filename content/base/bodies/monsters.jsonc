// P8-LM-3 (D8): four more kinds on the same resolver. Each is a plan, materials and traits (no special combat rule): what a creature is built of decides how it dies.
// The bog-thing: the human frame in peat and bog oak, 140 kg of sodden roots that rose from a mire. No blood, no organs; its bones are black bog oak. It grasps a foe and
// drags him under (the plan's grasp: a drag toward water); the breath rule drowns him. It is undone only when its upper body is destroyed or both sides of the ribs shatter.
{
 "type": "body_plan", "id": "bog_thing", "name": "Bog-thing", "copy_from": "human", "size_cm3": 140000, "blood_ml": 0, "blood_ml_per_kg": 0,
 "bleeds": false, "feels_pain": false, "animating_core": "upper_body", "tissue_set": "bog", "dark_sight": true,
 "tissue_map": { "skin": "peat_flesh", "fat": "peat_flesh", "muscle": "peat_flesh", "bone_tissue": "bog_oak" },
 "drop_organs": true, "drop_structure_kinds": ["artery", "vein"],
 "grasp": { "kind": "drag", "force_n": 1800, "chance_pm": 350, "range_mm": 1500, "drag_mmps": 1400 }
},
// The barghest: the black hound of ruins, 90 kg on the shared four-legged frame under a coat of hound hide. It runs at 9 m/s (a man sprints at about 5), flees below 40%
// blood, and in the dark of night its howl is a fright (once a fight, foes within 8 m lose 150 permille of their morale).
{
 "type": "body_plan", "id": "barghest", "name": "Barghest", "copy_from": "quadruped", "size_cm3": 90000, "blood_ml": 6300, "blood_ml_per_kg": 70, "untargetable_pm": 60,
 "tissue_set": "animal", "tissue_map": { "hide": "hound_hide" }, "flee_below_blood_pm": 400, "dark_sight": true, "speed_pm": 1800,
 "fear": { "radius_m": 8, "shock_pm": 150, "night_only": true }
},
// The lindworm: a great serpent of deep caves, 9 m long and 1,800 kg in six segments (head, neck, fore coil, mid coil, aft coil, tail), scaled in horn plates over fat, muscle
// and a spine of heavy bone. Cold-blooded (little blood, slow to bleed), it flees below 25%; it bites, and constricts: a hold at 6,000 N on the chest.
{
