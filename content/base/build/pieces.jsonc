  { "type": "build_piece", "id": "tanning_rack",         "name": "Tanning rack",      "kind": "workstation", "glyph": "R", "material": "oak", "station": "tanning" },

  // ---- fortification and yard pieces ----
  { "type": "build_piece", "id": "palisade",             "name": "Palisade",          "kind": "wall", "glyph": "!", "material": "oak" },
  { "type": "build_piece", "id": "fence_wood",           "name": "Plank fence",       "kind": "wall", "glyph": "-", "material": "oak" },
  { "type": "build_piece", "id": "wall_crenellated",     "name": "Crenellated parapet", "kind": "wall", "glyph": "=", "material": "granite" },
  { "type": "build_piece", "id": "wall_brick",           "name": "Brick wall",        "kind": "wall", "glyph": "&", "material": "fired_brick" },
  { "type": "build_piece", "id": "gate_wood",            "name": "Wooden gate",       "kind": "door", "glyph": "g", "material": "oak" },
  { "type": "build_piece", "id": "gate_iron",            "name": "Iron-bound gate",   "kind": "door", "glyph": "w", "material": "wrought_iron" },
  { "type": "build_piece", "id": "door_cell",            "name": "Barred cell door",  "kind": "door", "glyph": "d", "material": "wrought_iron" },
  { "type": "build_piece", "id": "window_open",          "name": "Open arch",         "kind": "window", "glyph": "a", "material": "granite" },
  { "type": "build_piece", "id": "stairs_stone_up",      "name": "Stone stairs up",   "kind": "stairs_up", "glyph": "{", "material": "granite" },
  { "type": "build_piece", "id": "stairs_stone_down",    "name": "Stone stairs down", "kind": "stairs_down", "glyph": "}", "material": "granite" },

