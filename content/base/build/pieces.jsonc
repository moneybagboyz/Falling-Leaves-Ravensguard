// Building pieces (plan §2.9). Kind drives the room detector, pathing and structural support; `glyph` is the text-dump character.
// Walls and posts hold up the floor above (plan §2.2a). Tags are what room types look for; workstations also get "station:<id>".
// Stone pieces use granite by default; culture styles can swap in local stone.
// "build" (P5-B): skill, worker_hours at skill 50, tools (craft_tool qualities), materials (good, kg per cell), hp, carries_storeys, salvage_pm, outdoor_work, rain_stops, min_skill, effort.
// "kg" (P5-A3, optional) is the piece mass the room-value formula uses; without it the default for the kind applies (RoomValue.DefaultKg).
[
  // ground and floors
  { "type": "build_piece", "id": "ground_dirt",          "name": "Dirt ground",       "kind": "ground", "glyph": ",", "build": { "skill": "none", "worker_hours": 0.25, "materials": [], "hp": 0, "salvage_pm": 0 } },
  { "type": "build_piece", "id": "floor_packed_earth",   "name": "Packed earth floor", "kind": "floor", "glyph": ".", "build": { "skill": "none", "worker_hours": 0.5, "materials": [], "hp": 50, "salvage_pm": 0 } },
