  { "type": "improvised", "id": "torch",      "name": "Torch",       "volume_cm3": 900,  "material": "ash",  "ignites": true },
  { "type": "improvised", "id": "pitchfork",  "name": "Pitchfork",   "volume_cm3": 1400, "material": "ash",  "attack": "point", "contact_area": 5, "penetration_mm": 200 },
  { "type": "improvised", "id": "frying_pan", "name": "Frying pan",  "volume_cm3": 180,  "material": "iron" },
  { "type": "improvised", "id": "bottle",     "name": "Bottle",      "volume_cm3": 450,  "material": "fired_brick", "breaks_after": 1, "leaves": "shards" },
  { "type": "improvised", "id": "rock",       "name": "Rock",        "volume_cm3": 190,  "material": "granite" },
