  { "type": "mounted_tuning", "id": "default",
    "charge_k_milli_per_kgmps": 10,
    "charge_weapon_pm": { "lance_couched": 1000, "tourney_couched": 500, "polearm_overhand": 600, "one_hand": 350, "thrown": 0, "bow": 0 },
