// Reusable requirement sets (basic-crafting spec 3.1 `using`), plus the qualities that stations and tools provide (3.1).
[
  { "type": "requirement_set", "id": "oven_or_hearth", "name": "A hearth or oven", "qualities": [ { "quality": "heat", "level": 2 } ] },
  { "type": "requirement_set", "id": "fire_and_pot", "name": "A lit fire and a pot", "qualities": [ { "quality": "heat", "level": 2 }, { "quality": "cooking", "level": 1 } ] },
  { "type": "requirement_set", "id": "needle_and_thread", "name": "Needle and thread", "qualities": [ { "quality": "sewing", "level": 1 } ] },
  { "type": "requirement_set", "id": "smithing_set", "name": "Forge, anvil and tongs", "qualities": [ { "quality": "heat", "level": 3 }, { "quality": "anvil", "level": 1 }, { "quality": "gripping", "level": 1 } ] },
  { "type": "requirement_set", "id": "water_source", "name": "Water", "water": true },

  // stations: the build pieces that count, and what they provide
  { "type": "craft_station", "id": "hearth",   "name": "Hearth",    "pieces": ["hearth", "hearth_central", "hearth_chimney"], "provides": { "cooking": 2, "heat": 2 } },
  { "type": "craft_station", "id": "oven",     "name": "Oven",      "pieces": ["oven"], "provides": { "cooking": 3, "heat": 3, "baking": 1 } },
  { "type": "craft_station", "id": "forge",    "name": "Forge",     "pieces": ["forge"], "provides": { "heat": 3, "smithing": 1 } },
  { "type": "craft_station", "id": "anvil",    "name": "Anvil",     "pieces": ["anvil"], "provides": { "anvil": 1, "hammering": 3 } },
  { "type": "craft_station", "id": "workbench", "name": "Work bench", "pieces": ["workbench"], "provides": { "workbench": 1 }, "kind": "work_bench" },
  { "type": "craft_station", "id": "brew_vat", "name": "Brewing vat", "pieces": ["brewing_vat"], "provides": { "brewing": 1 } },
  { "type": "craft_station", "id": "loom",     "name": "Loom",      "pieces": ["loom"], "provides": { "weaving": 1 } },
  { "type": "craft_station", "id": "tan_pit",  "name": "Tanning pit", "pieces": ["tanning_pit", "tanning_rack"], "provides": { "soaking": 1 } },
  { "type": "craft_station", "id": "campfire", "name": "Lit fire",  "pieces": [], "provides": { "heat": 2, "cooking": 1 } },
  // P5-E (crafting-full 3.2): one station vocabulary. "kind" is the Phase 2 station kind a business recipe names (the recipe book view), when it differs from the id.
  { "type": "craft_station", "id": "millstone",      "name": "Millstones",      "pieces": ["millstone"],      "provides": { "milling": 2 }, "kind": "mill_stones" },
  { "type": "craft_station", "id": "malting_floor",  "name": "Malting floor",   "pieces": ["malting_floor"],  "provides": { "malting": 1 }, "kind": "malt_floor" },
  { "type": "craft_station", "id": "butcher_block",  "name": "Butcher's block", "pieces": ["butcher_block"],  "provides": { "butchery": 1 } },
  { "type": "craft_station", "id": "salting_tub",    "name": "Salting tub",     "pieces": ["salting_tub"],    "provides": { "soaking": 1, "storage": 1 } },
  { "type": "craft_station", "id": "cheese_press",   "name": "Cheese press",    "pieces": ["cheese_press"],   "provides": { "pressing": 1 } },
  { "type": "craft_station", "id": "candle_table",   "name": "Candle table",    "pieces": ["candle_table"],   "provides": { "chandlery": 1 } },
  { "type": "craft_station", "id": "spinning_wheel", "name": "Spinning wheel",  "pieces": ["spinning_wheel"], "provides": { "spinning": 2 } },
  { "type": "craft_station", "id": "fulling_tub",    "name": "Fulling tub",     "pieces": ["fulling_tub"],    "provides": { "soaking": 1, "fulling": 1 } },
  { "type": "craft_station", "id": "dye_vat",        "name": "Dye vat",         "pieces": ["dye_vat"],        "provides": { "dyeing": 1, "boiling": 1 } },
  { "type": "craft_station", "id": "tailor_bench",   "name": "Tailor's bench",  "pieces": ["tailor_bench"],   "provides": { "tailoring": 1 } },
  { "type": "craft_station", "id": "cobbler_bench",  "name": "Cobbler's bench", "pieces": ["cobbler_bench"],  "provides": { "cobbling": 1 } },
  { "type": "craft_station", "id": "saddle_tree",    "name": "Saddle tree",     "pieces": ["saddle_tree"],    "provides": { "saddlery": 1 } },
  { "type": "craft_station", "id": "charcoal_clamp", "name": "Charcoal clamp",  "pieces": ["charcoal_clamp"], "provides": { "charring": 1 } },
  { "type": "craft_station", "id": "bloomery",       "name": "Bloomery",        "pieces": ["bloomery"],       "provides": { "heat": 4, "bellows": 1, "smelting": 1 } },
  { "type": "craft_station", "id": "cupel_hearth",   "name": "Cupel hearth",    "pieces": ["cupel_hearth"],   "provides": { "heat": 4, "refining": 1 } },
  { "type": "craft_station", "id": "sawpit",         "name": "Sawpit",          "pieces": ["sawpit"],         "provides": { "sawing": 2 }, "kind": "saw_pit" },
  { "type": "craft_station", "id": "cooper_bench",   "name": "Cooper's bench",  "pieces": ["cooper_bench"],   "provides": { "coopering": 1 }, "kind": "barrel_bench" },
  { "type": "craft_station", "id": "wheelwright",    "name": "Wheelwright's bay", "pieces": ["wheel_pit", "spoke_bench"], "provides": { "wheelwright": 1 }, "kind": "wheelwright_bay" },
  { "type": "craft_station", "id": "brick_clamp",    "name": "Brick clamp",     "pieces": ["brick_clamp"],    "provides": { "firing": 1, "heat": 3 } },
  { "type": "craft_station", "id": "kiln",           "name": "Kiln",            "pieces": ["kiln"],           "provides": { "firing": 2, "heat": 4 } },
  { "type": "craft_station", "id": "lime_kiln",      "name": "Lime kiln",       "pieces": ["lime_kiln"],      "provides": { "firing": 1, "heat": 4 } },
  { "type": "craft_station", "id": "mason_yard",     "name": "Mason's banker",  "pieces": ["mason_banker"],   "provides": { "masonry": 1 } },
  { "type": "craft_station", "id": "potters_wheel",  "name": "Potter's wheel",  "pieces": ["potters_wheel"],  "provides": { "potting": 1 } },
  { "type": "craft_station", "id": "slipway",        "name": "Slipway",         "pieces": ["slipway_ways"],   "provides": { "shipwright": 1 } },
  { "type": "craft_station", "id": "tyre_ring",      "name": "Tyre ring",       "pieces": ["tyre_ring"],      "provides": { "tyre": 1, "heat": 2 } },

  // tools: what a carried item can do
  { "type": "craft_tool", "id": "knife",   "name": "Knife",   "qualities": { "cutting": 1 }, "wear_pm_per_hour": { "cutting": 1 } },
  { "type": "craft_tool", "id": "axe",     "name": "Axe",     "qualities": { "cutting": 1, "chopping": 1 }, "wear_pm_per_hour": { "cutting": 1, "chopping": 2 } },
  { "type": "craft_tool", "id": "saw",     "name": "Saw",     "qualities": { "sawing": 1 }, "wear_pm_per_hour": { "sawing": 1.5 } },
  { "type": "craft_tool", "id": "needle",  "name": "Needle",  "qualities": { "sewing": 1 }, "wear_pm_per_hour": { "sewing": 0.5 } },
  { "type": "craft_tool", "id": "hammer",  "name": "Hammer",  "qualities": { "hammering": 2 }, "wear_pm_per_hour": { "hammering": 1 } },
  { "type": "craft_tool", "id": "steel_and_flint", "name": "Steel and flint", "qualities": { "fire_starting": 1 } },
  { "type": "craft_tool", "id": "pot",     "name": "Cooking pot", "qualities": { "cooking": 1, "boiling": 1 } },
  { "type": "craft_tool", "id": "quern",   "name": "Quern",   "qualities": { "milling": 1 } },
  { "type": "craft_tool", "id": "whetstone", "name": "Whetstone", "qualities": { "whetting": 1 } },
  { "type": "craft_tool", "id": "spindle", "name": "Spindle", "qualities": { "spinning": 1 } },
  { "type": "craft_tool", "id": "tongs",   "name": "Smith's tongs", "qualities": { "gripping": 1 } },
  { "type": "craft_tool", "id": "tub",     "name": "Wooden tub", "qualities": { "soaking": 1 } },
  { "type": "craft_tool", "id": "crock",   "name": "Crock or barrel", "qualities": { "storage": 1 } },
  // P5-A1 (items-quality-and-wear 4.3): the appended qualities, and the wear an attended hour takes at Common (permille of condition; the tier's wear_pm scales it)
  { "type": "craft_tool", "id": "chisel",  "name": "Chisel",  "qualities": { "chiselling": 1, "cutting": 1 }, "wear_pm_per_hour": { "chiselling": 3, "cutting": 3 } },
  { "type": "craft_tool", "id": "spade",   "name": "Spade",   "qualities": { "digging": 1 }, "wear_pm_per_hour": { "digging": 2 } },
  { "type": "craft_tool", "id": "crowbar", "name": "Crowbar", "qualities": { "prying": 1, "lifting": 1 }, "wear_pm_per_hour": { "prying": 1, "lifting": 1 } },
  // P5-E (decided with the user): limited field kits. Level 1 qualities anywhere, at a -5 score penalty when the kit is what supplies them; enough for mending, sharpening,
  // fletching and field repairs. Smithing steps still need the forge and anvil stations (the kits give no heat and no anvil).
  { "type": "craft_tool", "id": "sewing_kit",      "name": "Sewing kit",        "qualities": { "sewing": 1, "cutting": 1 },     "wear_pm_per_hour": { "sewing": 0.5, "cutting": 1 }, "field_kit": true },
  { "type": "craft_tool", "id": "whetstone_file",  "name": "Whetstone and file", "qualities": { "whetting": 1, "scraping": 1 },  "wear_pm_per_hour": { "whetting": 1, "scraping": 1 }, "field_kit": true },
  { "type": "craft_tool", "id": "fletching_kit",   "name": "Fletching kit",     "qualities": { "fletching": 1, "cutting": 1 },  "wear_pm_per_hour": { "fletching": 1, "cutting": 1 }, "field_kit": true },
  { "type": "craft_tool", "id": "field_smith_kit", "name": "Field smithing kit", "qualities": { "hammering": 1, "gripping": 1 }, "wear_pm_per_hour": { "hammering": 1, "gripping": 0.5 }, "field_kit": true }
]
