// The numbers of faith and church (docs/specs/phase6/faith-and-church.md 4): piety, holy days and services, the tithe split and the see, pilgrimage. The defaults are the spec's.
// P6-E2 adds heresy, excommunication, relics, superstition and believed miracles to the same row; every number has its default in FaithSettingsDef (HeresyStartPm 20, ExcommunicationGiftMites 10000, PenancePct 10, LairKm 10, WitchHuntAt 70, MiraclePct 15 ...).
[
  {"type": "faith_settings", "id": "faith"},
  // what the hero is given on arriving at a shrine (a pilgrim's badge); the loot tables never pick it
  {"type": "site_item", "id": "pilgrim_badge", "name": "Pilgrim's badge", "mass_g": 30, "value_mites": 8, "kind": "church", "material": "tin"},
  // a charm bought from the priest where superstition is high (P6-E2, 4.7)
  {"type": "site_item", "id": "charm", "name": "Charm", "mass_g": 20, "value_mites": 20, "kind": "church", "material": "tin"}
]
