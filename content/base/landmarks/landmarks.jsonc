  {"type": "landmark", "id": "wayside_shrine", "name": "Wayside shrine", "weight": 12, "placer": 2, "attach_events": ["saint_died", "saint_rises", "plague_ends"], "near_road": true, "min_settlement_m": 500, "max_settlement_m": 6000, "lore": "A shrine of weathered wood where the road bends, set up after {event} in year {year}. {person} is the name on the lintel, and travellers from {place} leave a coin or a crust.", "lore_unattached": "A shrine of weathered wood where the road bends. Nobody in {place} knows which saint it was for, but it is never without a candle.", "props": [{"kind": "signpost", "dx": 0, "dy": 0}, {"kind": "brazier", "dx": 1, "dy": 0}, {"kind": "bench", "dx": -2, "dy": 1}, {"kind": "low_wall", "dx": -2, "dy": -1}, {"kind": "low_wall", "dx": 2, "dy": -1}, {"kind": "bush", "dx": 3, "dy": 2}, {"kind": "stump", "dx": -3, "dy": 3}]},

  {"type": "landmark", "id": "famine_stone", "name": "Famine stone", "weight": 9, "placer": 2, "attach_events": ["famine", "bad_year", "settlement_starved"], "min_settlement_m": 500, "max_settlement_m": 4000, "biomes": ["grassland", "temperate_forest", "steppe", "marsh"], "lore": "A squat stone cut with the height of the water in {event}, year {year}, so that the next hungry year could be told from the last. {place} still reckons its harvests against the mark.", "lore_unattached": "A squat stone cut with the heights of old hungry years. {place} still reckons its harvests against the lowest mark.", "props": [{"kind": "boulder", "dx": 0, "dy": 0, "variant": 1}, {"kind": "rocks", "dx": 2, "dy": 1}, {"kind": "rocks", "dx": -2, "dy": -1}, {"kind": "sheaves", "dx": 3, "dy": 3}, {"kind": "sheaves", "dx": -3, "dy": 3}, {"kind": "bush", "dx": 4, "dy": -2}]},

  {"type": "landmark", "id": "peace_stone", "name": "Peace stone", "weight": 10, "placer": 2, "attach_events": ["peace_signed", "treaty_lapses", "succession_crisis"], "near_road": true, "min_settlement_m": 900, "max_settlement_m": 8000, "lore": "A tall stone planted where the envoys of {realm} stood for {event} in year {year}. The boundary was cut into it and then argued over for a generation.", "lore_unattached": "A tall stone with a boundary cut into it that nobody in {place} will read aloud. The sheep graze on both sides of the line.", "props": [{"kind": "boulder", "dx": 0, "dy": 0, "variant": 2}, {"kind": "boulder", "dx": 1, "dy": 0}, {"kind": "signpost", "dx": -3, "dy": 2}, {"kind": "bench", "dx": 3, "dy": 2}, {"kind": "bench", "dx": -3, "dy": -2}, {"kind": "rocks", "dx": 0, "dy": 4}]},

