// Quick Start origin cards (plan §3 item 1). Skill/attribute entries are deltas on the rolled commoner.
// Kit ids are weapon_shape / armour_shape ids from content/base/items; coin is in crowns (plan 4A.1: 1 crown is about a silver penny); start_location is a place kind the embark step resolves.
// P5-A4 (inheritance 3): "kin" rows give the hero real kin in the person table (rel child, spouse_dead, parent or none; age and count ranges, rolled with stream 0x560); an origin without
// "kin" keeps the Phase 4 rule (the grown child of a household of the start region). "age" is the hero's age range in years; "occupation" what the hero's person row says he does.
[
  { "type": "origin", "id": "disgraced_squire", "name": "Disgraced squire", "order": 1,
    "description": "You carried a knight's shield until a lie or a truth ended it. The training is still in your arms; the name is not.",
    "skills": { "melee": 15, "riding": 10, "literacy": 5 }, "attributes": { "strength": 4, "dexterity": 3 },
    "kit": [ { "item": "arming_sword" }, { "item": "gambeson" }, { "item": "cloak" } ], "coin": 40,
    "start_location": "town", "ambition": "regain_honour", "mentor": "old_knight",
    "age": [22, 28], "kin": [ { "rel": "parent", "age": [48, 66], "count": [1, 1] } ] },

  { "type": "origin", "id": "peddler", "name": "Peddler", "order": 2,
    "description": "You have walked every road in the district with a pack on your back, and you know what each village runs short of.",
    "skills": { "trading": 20, "literacy": 5 }, "attributes": { "perception": 4, "wits": 3 },
    "kit": [ { "item": "dagger" }, { "item": "tunic" }, { "item": "cloak" } ], "coin": 120,
    "start_location": "road", "ambition": "make_your_fortune", "mentor": "caravan_master" },

  { "type": "origin", "id": "runaway_serf", "name": "Runaway serf", "order": 3,
    "description": "A year and a day in a town makes a person free, or so they say. You only have to survive the year.",
    "skills": { "farming": 10, "forestry": 10 }, "attributes": { "toughness": 6 },
    "kit": [ { "item": "club" }, { "item": "shirt" } ], "coin": 3,
    "start_location": "wilds", "ambition": "be_free", "mentor": "free_farmer" },

  { "type": "origin", "id": "discharged_soldier", "name": "Discharged soldier", "order": 4,
    "description": "The war moved on and the lord stopped paying. You kept the spear, and the habit of watching doorways.",
    "skills": { "melee": 20, "archery": 5, "leadership": 5 }, "attributes": { "strength": 6, "toughness": 4 },
    "kit": [ { "item": "spear" }, { "item": "gambeson" }, { "item": "helm" } ], "coin": 25,
    "start_location": "town", "ambition": "raise_a_company", "mentor": "old_sergeant",
    "age": [26, 36], "kin": [ { "rel": "none" } ], "occupation": "guard" },

  { "type": "origin", "id": "monastery_orphan", "name": "Monastery orphan", "order": 5,
    "description": "Raised on bread, copying and cold stone floors. You can read the old hands, and you have never owned a coin.",
    "skills": { "literacy": 20, "theology": 10, "cooking": 5 }, "attributes": { "wits": 8 },
    "kit": [ { "item": "shirt" }, { "item": "tunic" }, { "item": "cloak" } ], "coin": 5,
    "start_location": "monastery", "ambition": "uncover_the_truth", "mentor": "prior" },

  { "type": "origin", "id": "minor_heir", "name": "Minor heir", "order": 6,
    "description": "Third child of a poor house with a long name. You were taught the law and the lance and given neither land nor money.",
    "skills": { "leadership": 10, "law": 10, "riding": 10, "melee": 5 }, "attributes": { "wits": 4 },
    "kit": [ { "item": "arming_sword" }, { "item": "tunic" }, { "item": "cloak" } ], "coin": 200,
    "start_location": "manor", "ambition": "claim_your_inheritance", "mentor": "steward" },

  { "type": "origin", "id": "outlaw", "name": "Outlaw", "order": 7,
    "description": "There is a price on a name that is no longer yours. The greenwood keeps secrets better than the town does.",
    "skills": { "melee": 10, "archery": 10, "forestry": 5 }, "attributes": { "dexterity": 6, "perception": 4 },
    "kit": [ { "item": "dagger" }, { "item": "axe" }, { "item": "cloak" } ], "coin": 10,
    "start_location": "wilds", "ambition": "clear_your_name", "mentor": "fence" },

  // P5-H (inheritance): the concept book's tanner's widow, the eighth card. She begins with an estate ("inherits"): her late husband's tannery in a house leased from the lord, two seasons of
  // its rent behind (his debt), a little coin in its box and hides and bark in its store; her children are rows of her household (0 to 2, aged 6 to 14) and the dead husband a row.
  { "type": "origin", "id": "tanners_widow", "name": "Tanner's widow", "order": 8,
    "description": "Your husband's vats stand cold. The tannery is yours now, and so are his debts: two seasons of the lord's rent.", "sex": "female",
    "skills": { "tanning": 15, "trading": 5 }, "attributes": { "toughness": 3 },
    "kit": [ { "item": "dagger" }, { "item": "tunic" }, { "item": "cloak" } ], "coin": 45,
    "start_location": "town", "ambition": "keep_the_tannery", "mentor": "journeyman",
    "age": [28, 36], "occupation": "tanner",
    "kin": [ { "rel": "spouse_dead", "age": [30, 42], "count": [1, 1] }, { "rel": "child", "age": [6, 14], "count": [0, 2] } ],
    "inherits": { "business": "tannery", "arrears_seasons": 2, "cash_mites": 600, "stock": { "hide_raw": 100000, "oak_bark": 40000 }, "years": 12 } }
]
