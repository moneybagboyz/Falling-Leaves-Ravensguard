  { "type": "scale_settings", "id": "default",
    "grades": [
      { "skill": "Smithing", "grades_pm": [200, 400, 400] },
      { "skill": "Weaving", "grades_pm": [100, 300, 600] },
      { "skill": "Tailoring", "grades_pm": [200, 400, 400] },
      { "skill": "Brewing", "grades_pm": [200, 300, 500] },
      { "skill": "Carpentry", "grades_pm": [150, 450, 400] },
      { "recipe": "saw_planks", "grades_pm": [0, 300, 700] },
      { "recipe": "burn_charcoal", "grades_pm": [0, 200, 800] },
      { "recipe": "fire_bricks", "grades_pm": [50, 150, 800] }
    ],
    "crew_max": [
      { "station": "anvil", "max": 3 }, { "station": "forge", "max": 4 }, { "station": "loom", "max": 2 }, { "station": "saw_pit", "max": 2 },
      { "station": "brick_clamp", "max": 3 }, { "station": "kiln", "max": 6 }, { "station": "bloomery", "max": 4 }
    ],
    "crew_max_default": 6, "unsupervised_pm": 1500, "master_skill": 60, "journeyman_skill": 30,
