// Traps (exploration-and-sites 4.6, P4-H). Effects go through the resolver: a blow (blunt or point, momentum in milli-units, contact area mm2,
// penetration mm) on a part picked by the listed chances (a base part id: the side is drawn), a fall of fall_mm (a pit: spiked pits add 1-3 point blows),
// a collapsing floor (all in 3 x 3 drop a level and fall), an alarm (wakes the band within alarm_m) or a held foot (Athletics to open, hold_s).
// Detect and disarm are difficulties against Perception and Lockpicking (4.6: P = clamp(5 + (skill - difficulty)/2 + light bonus, 2, 80) per sim-second).
[
  { "type": "site_trap", "id": "deadfall", "effect": "blow", "attack": "blunt", "momentum_milli": 160000, "area_mm2": 100, "detect": 40, "disarm": 35,
    "parts": [ {"part": "upper_body", "pm": 400}, {"part": "head", "pm": 300}, {"part": "upper_arm", "pm": 300} ], "where": ["Barrow", "Ruin"] },
  { "type": "site_trap", "id": "pit", "effect": "fall", "fall_mm": 3000, "spike_milli": 90000, "area_mm2": 6, "pen_mm": 20, "detect": 30, "disarm": 30,
    "parts": [ {"part": "lower_leg", "pm": 500}, {"part": "upper_leg", "pm": 300}, {"part": "lower_body", "pm": 200} ], "where": ["Barrow", "Ruin", "Cave"] },
  { "type": "site_trap", "id": "collapsing_floor", "effect": "floor", "fall_mm": 3000, "detect": 35, "disarm": 0,
    "parts": [ {"part": "lower_leg", "pm": 450}, {"part": "upper_leg", "pm": 250}, {"part": "lower_arm", "pm": 150}, {"part": "upper_body", "pm": 150} ], "where": ["Ruin"] },
  { "type": "site_trap", "id": "spring_spears", "effect": "blow", "attack": "point", "momentum_milli": 110000, "area_mm2": 10, "pen_mm": 40, "detect": 45, "disarm": 40,
    "parts": [ {"part": "upper_body", "pm": 500}, {"part": "upper_leg", "pm": 500} ], "where": ["Barrow", "Ruin"] },
  { "type": "site_trap", "id": "tripwire_alarm", "effect": "alarm", "alarm_m": 30, "detect": 25, "disarm": 20, "where": ["Cave"] },
  { "type": "site_trap", "id": "bear_trap", "effect": "hold", "attack": "blunt", "momentum_milli": 140000, "area_mm2": 25, "hold_s": 20, "detect": 30, "disarm": 25,
    "parts": [ {"part": "lower_leg", "pm": 1000} ], "where": ["Cave"] },
  { "type": "site_trap", "id": "snare", "effect": "hold", "attack": "blunt", "momentum_milli": 40000, "area_mm2": 25, "hold_s": 10, "detect": 30, "disarm": 25,
    "parts": [ {"part": "lower_leg", "pm": 1000} ], "where": ["Cave"] }
