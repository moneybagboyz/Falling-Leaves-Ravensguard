// docs/specs/phase3/horses-and-carts.md 3.3 and docs/specs/phase5/vehicle-designer.md 3.1. One cell is 1 m x 1 m, so a part is what stands in one square metre (a cargo bed cell carries 125 kg / 250 L; a wheel is its own cell stack on the frame).
// A part's cargo is what its cell holds (kg and litres); needs_below lists parts one of which must lie under it in the same cell. P5-G fields (all optional): category (the designer's palette), recipe (the craft recipe
// that makes it), repair (the recipe that mends it), install_h (worker-hours to fit it), steer, axle_kg, the hull form (waterplane_pm, block_pm, hull_depth_mm: a keel's form wins over the planks'), rowers, polers,
// sail_m2, height_mm (centre of mass above the keel), rough_wear_pm (hit-point loss on bad ground) and station.
[
  // ---- Phase 3: the template carts' parts ----
  { "type": "vehicle_part", "id": "frame_plank",  "name": "Frame plank",  "mass_kg": 6,  "volume_l": 20,  "hp": 80,  "tags": ["frame"], "category": "frame", "recipe": "cut_frame_plank", "repair": "repair_vehicle_frame", "install_h": 0.5, "height_mm": 600 },
  { "type": "vehicle_part", "id": "axle_wood",    "name": "Wooden axle",  "mass_kg": 9,  "volume_l": 10,  "hp": 100, "tags": ["axle"], "category": "wheels", "recipe": "make_axle", "repair": "repair_vehicle_frame", "install_h": 1.0, "axle_kg": 750, "height_mm": 400 },
  { "type": "vehicle_part", "id": "wheel_solid",  "name": "Solid wheel",  "mass_kg": 5,  "volume_l": 30,  "hp": 90,  "tags": ["wheel"], "category": "wheels", "recipe": "make_solid_wheel", "repair": "repair_cart_wheel", "install_h": 0.5, "height_mm": 400 },
  { "type": "vehicle_part", "id": "wheel_spoked", "name": "Spoked wheel", "mass_kg": 20, "volume_l": 120, "hp": 120, "tags": ["wheel"], "category": "wheels", "recipe": "make_spoked_wheel", "repair": "repair_cart_wheel", "install_h": 0.5, "height_mm": 500 },
  { "type": "vehicle_part", "id": "iron_tyre",    "name": "Iron tyre",    "mass_kg": 4,  "volume_l": 5,   "hp": 200, "needs_below": ["wheel_spoked", "wheel_dished"], "tags": ["tyre"], "category": "wheels", "recipe": "forge_iron_tyre", "install_h": 0.5, "height_mm": 500 },
  { "type": "vehicle_part", "id": "shaft_pair",   "name": "Shaft",        "mass_kg": 6 , "volume_l": 40,  "hp": 70,  "tags": ["hitch", "shafts"], "category": "hitch", "recipe": "make_shafts", "repair": "repair_vehicle_frame", "install_h": 0.5, "steer": "shafts", "height_mm": 700 },
  { "type": "vehicle_part", "id": "pole_yoke",    "name": "Yoke",         "mass_kg": 10, "volume_l": 30,  "hp": 90,  "tags": ["hitch", "pole_yoke"], "category": "hitch", "recipe": "make_yoke", "repair": "repair_vehicle_frame", "install_h": 0.5, "height_mm": 900 },
  { "type": "vehicle_part", "id": "pole_beam",    "name": "Pole",         "mass_kg": 4,  "volume_l": 20,  "hp": 80,  "tags": ["pole"], "category": "hitch", "recipe": "make_pole", "repair": "repair_vehicle_frame", "install_h": 0.5, "steer": "pole", "height_mm": 700 },
  { "type": "vehicle_part", "id": "traces",       "name": "Traces",       "mass_kg": 2,  "volume_l": 5,   "hp": 40,  "tags": ["hitch", "traces"], "category": "hitch", "recipe": "make_traces", "install_h": 0.25, "height_mm": 600 },
  { "type": "vehicle_part", "id": "cargo_bed",    "name": "Cargo bed",    "mass_kg": 10, "volume_l": 200, "cargo_kg": 125, "cargo_l": 250, "hp": 120, "needs_below": ["frame_plank", "runner"], "tags": ["bed"], "category": "cargo", "recipe": "make_cargo_bed", "repair": "repair_vehicle_frame", "install_h": 1.0, "height_mm": 800 },
  { "type": "vehicle_part", "id": "cargo_box",    "name": "Cargo box",    "mass_kg": 8,  "volume_l": 150, "cargo_kg": 75,  "cargo_l": 150, "hp": 80,  "tags": ["bed", "body"], "category": "cargo", "recipe": "make_cargo_box", "repair": "repair_vehicle_frame", "install_h": 0.5, "height_mm": 600 },
  { "type": "vehicle_part", "id": "barrow_tray",  "name": "Barrow tray",  "mass_kg": 8,  "volume_l": 100, "cargo_kg": 80,  "cargo_l": 100, "hp": 70,  "tags": ["bed", "body"], "category": "cargo", "recipe": "make_barrow_tray", "repair": "repair_vehicle_frame", "install_h": 0.5, "height_mm": 500 },
  { "type": "vehicle_part", "id": "cargo_rack",   "name": "Cargo rack",   "mass_kg": 8,  "volume_l": 500, "cargo_kg": 100, "cargo_l": 500, "hp": 90,  "needs_below": ["frame_plank"], "tags": ["bed", "bulk"], "category": "cargo", "recipe": "make_cargo_rack", "repair": "repair_vehicle_frame", "install_h": 0.5, "height_mm": 1200 },
  { "type": "vehicle_part", "id": "seat_bench",   "name": "Driver's bench","mass_kg": 4, "volume_l": 20,  "hp": 70,  "needs_below": ["frame_plank"], "tags": ["seat"], "category": "seats", "recipe": "make_seat_bench", "install_h": 0.5, "height_mm": 1000 },
  { "type": "vehicle_part", "id": "tilt_hoops",   "name": "Tilt hoops",   "mass_kg": 6,  "volume_l": 80,  "hp": 50,  "tags": ["tilt"], "category": "cover", "recipe": "make_tilt_hoops", "install_h": 0.5, "height_mm": 1800 },
  { "type": "vehicle_part", "id": "tilt_cloth",   "name": "Tilt cloth",   "mass_kg": 5,  "volume_l": 20,  "hp": 40,  "needs_below": ["tilt_hoops"], "tags": ["tilt"], "category": "cover", "recipe": "sew_tilt_cloth", "install_h": 0.25, "height_mm": 2000 },
  { "type": "vehicle_part", "id": "runner",       "name": "Runner",       "mass_kg": 8,  "volume_l": 40,  "hp": 90,  "tags": ["runner"], "category": "frame", "recipe": "make_runner", "repair": "repair_vehicle_frame", "install_h": 0.5, "height_mm": 200 },
  { "type": "vehicle_part", "id": "handle_bars",  "name": "Handle bars",  "mass_kg": 4,  "volume_l": 20,  "hp": 60,  "tags": ["handle"], "category": "hitch", "recipe": "make_handle_bars", "install_h": 0.25, "steer": "handles", "height_mm": 800 },
  { "type": "vehicle_part", "id": "iron_fitting", "name": "Iron fittings","mass_kg": 1,  "volume_l": 1,   "hp": 150, "tags": ["fitting"], "category": "frame", "recipe": "forge_hinges", "install_h": 0.25, "height_mm": 600 },

  // ---- P5-G: wheels and axles ----
  { "type": "vehicle_part", "id": "axle_pivot",      "name": "Pivoting front axle", "mass_kg": 14, "volume_l": 20, "hp": 100, "tags": ["axle"], "category": "wheels", "recipe": "make_pivot_axle", "repair": "repair_vehicle_frame", "install_h": 2.0, "steer": "pivot_axle", "axle_kg": 750, "height_mm": 400 },
  { "type": "vehicle_part", "id": "axle_iron_bound", "name": "Iron-bound axle",  "mass_kg": 13, "volume_l": 12, "hp": 160, "tags": ["axle"], "category": "wheels", "recipe": "make_iron_bound_axle", "repair": "repair_vehicle_frame", "install_h": 1.0, "axle_kg": 1000, "height_mm": 400 },
  { "type": "vehicle_part", "id": "wheel_dished",    "name": "Dished wheel",     "mass_kg": 22, "volume_l": 130, "hp": 140, "tags": ["wheel"], "category": "wheels", "recipe": "make_dished_wheel", "repair": "repair_cart_wheel", "install_h": 0.5, "rough_wear_pm": 700, "height_mm": 500 },
  { "type": "vehicle_part", "id": "brake_shoe",      "name": "Brake shoe",       "mass_kg": 3,  "volume_l": 4,  "hp": 60,  "needs_below": ["wheel_spoked", "wheel_dished", "wheel_solid"], "tags": ["brake"], "category": "wheels", "recipe": "make_brake_shoe", "install_h": 0.5, "height_mm": 400 },
  { "type": "vehicle_part", "id": "drag_shoe",       "name": "Drag shoe",        "mass_kg": 4,  "volume_l": 3,  "hp": 120, "tags": ["brake"], "category": "wheels", "recipe": "forge_drag_shoe", "install_h": 0.25, "height_mm": 300 },

  // ---- P5-G: hulls (a barge's flat planks; a keel gives a boat its fine lines) ----
  { "type": "vehicle_part", "id": "hull_plank",      "name": "Hull plank",       "mass_kg": 14, "volume_l": 30, "cargo_kg": 40, "cargo_l": 80, "hp": 120, "tags": ["hull"], "category": "hull", "recipe": "saw_hull_plank", "repair": "repair_hull_plank", "install_h": 2.0, "buoyant": true, "waterplane_pm": 900, "block_pm": 850, "hull_depth_mm": 900 },
  { "type": "vehicle_part", "id": "keel",            "name": "Keel",             "mass_kg": 10, "volume_l": 25, "hp": 200, "tags": ["hull", "keel"], "category": "hull", "recipe": "shape_keel", "repair": "repair_hull_plank", "install_h": 3.0, "buoyant": true, "waterplane_pm": 500, "block_pm": 500, "hull_depth_mm": 450 },
  { "type": "vehicle_part", "id": "gunwale",         "name": "Gunwale",          "mass_kg": 4,  "volume_l": 10, "hp": 90,  "needs_below": ["hull_plank"], "tags": ["gunwale"], "category": "hull", "recipe": "make_gunwale", "install_h": 1.0, "height_mm": 450 },
  { "type": "vehicle_part", "id": "deck_plank",      "name": "Deck planking",    "mass_kg": 20, "volume_l": 40, "cargo_kg": 300, "cargo_l": 500, "hp": 100, "needs_below": ["hull_plank", "frame_plank"], "tags": ["deck"], "category": "hull", "recipe": "saw_deck_plank", "repair": "repair_hull_plank", "install_h": 1.5, "height_mm": 600 },
  { "type": "vehicle_part", "id": "ferry_ramp",      "name": "Ferry ramp",       "mass_kg": 30, "volume_l": 60, "hp": 120, "needs_below": ["deck_plank"], "tags": ["ramp"], "category": "hull", "recipe": "make_ferry_ramp", "install_h": 2.0, "height_mm": 600 },

  // ---- P5-G: seats, oars, poles and steering ----
  { "type": "vehicle_part", "id": "thwart",          "name": "Thwart",           "mass_kg": 5,  "volume_l": 10, "hp": 70,  "needs_below": ["hull_plank"], "tags": ["seat", "thwart"], "category": "seats", "recipe": "make_thwart", "install_h": 1.0, "rowers": 1, "height_mm": 300 },
  { "type": "vehicle_part", "id": "rowlock",         "name": "Rowlocks and oars","mass_kg": 6,  "volume_l": 30, "hp": 60,  "needs_below": ["gunwale", "hull_plank"], "tags": ["oars"], "category": "sail", "recipe": "make_oars", "install_h": 0.5, "height_mm": 450 },
  { "type": "vehicle_part", "id": "quant_pole_rack", "name": "Quant poles",      "mass_kg": 6,  "volume_l": 40, "hp": 60,  "needs_below": ["deck_plank", "hull_plank"], "tags": ["poles"], "category": "sail", "recipe": "make_quant_pole", "install_h": 0.25, "polers": 1, "height_mm": 600 },
  { "type": "vehicle_part", "id": "steering_oar",    "name": "Steering oar",     "mass_kg": 8,  "volume_l": 25, "hp": 70,  "needs_below": ["hull_plank", "gunwale"], "tags": ["steer"], "category": "steering", "recipe": "make_steering_oar", "install_h": 0.5, "steer": "steering_oar", "height_mm": 400 },
  { "type": "vehicle_part", "id": "rudder",          "name": "Rudder",           "mass_kg": 15, "volume_l": 30, "hp": 100, "needs_below": ["hull_plank", "keel"], "tags": ["steer"], "category": "steering", "recipe": "make_rudder", "repair": "repair_hull_plank", "install_h": 2.0, "steer": "rudder", "height_mm": 300 },
  { "type": "vehicle_part", "id": "tow_post",        "name": "Tow post",         "mass_kg": 10, "volume_l": 15, "hp": 120, "needs_below": ["deck_plank", "hull_plank"], "tags": ["hitch", "tow"], "category": "hitch", "recipe": "make_tow_post", "install_h": 1.0, "height_mm": 900 },

  // ---- P5-G: sail ----
  { "type": "vehicle_part", "id": "mast",            "name": "Mast",             "mass_kg": 40, "volume_l": 80, "hp": 150, "needs_below": ["keel", "hull_plank"], "tags": ["mast"], "category": "sail", "recipe": "make_mast", "install_h": 4.0, "height_mm": 2500 },
  { "type": "vehicle_part", "id": "sail_square",     "name": "Square sail",      "mass_kg": 12, "volume_l": 40, "hp": 50,  "needs_below": ["mast"], "tags": ["sail"], "category": "sail", "recipe": "sew_square_sail", "install_h": 1.0, "sail_m2": 12, "height_mm": 3000 },

  // ---- P5-G: cover, cargo and workstations ----
  { "type": "vehicle_part", "id": "fish_well",       "name": "Fish well",        "mass_kg": 15, "volume_l": 120, "cargo_kg": 100, "cargo_l": 100, "hp": 80, "needs_below": ["hull_plank"], "tags": ["fish_well"], "category": "cargo", "recipe": "make_fish_well", "install_h": 1.5, "height_mm": 200 },
  { "type": "vehicle_part", "id": "cabin_box",       "name": "Cabin",            "mass_kg": 60, "volume_l": 400, "hp": 120, "needs_below": ["deck_plank", "frame_plank"], "tags": ["cabin"], "category": "cover", "recipe": "make_cabin_box", "install_h": 4.0, "height_mm": 1500 },
  { "type": "vehicle_part", "id": "stall_counter",   "name": "Stall counter",    "mass_kg": 25, "volume_l": 150, "cargo_kg": 60, "cargo_l": 150, "hp": 90, "needs_below": ["frame_plank", "deck_plank"], "tags": ["shop"], "category": "workstations", "recipe": "make_stall_counter", "install_h": 2.0, "height_mm": 1000 },
  { "type": "vehicle_part", "id": "mobile_hearth",   "name": "Mobile hearth",    "mass_kg": 40, "volume_l": 80, "hp": 100, "needs_below": ["frame_plank", "deck_plank"], "tags": ["hearth"], "category": "workstations", "recipe": "build_mobile_hearth", "install_h": 2.0, "station": "hearth", "height_mm": 900 }
]
