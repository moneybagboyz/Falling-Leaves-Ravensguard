    "legend": { "c": ["cargo_box", "axle_wood", "wheel_solid", "wheel_solid"], "H": ["cargo_box", "handle_bars", "iron_fitting"] }, "rows": [ "c", "H" ], "sprite": "vehicle.handcart" },
