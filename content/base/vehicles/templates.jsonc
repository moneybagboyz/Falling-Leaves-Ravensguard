    "legend": { "B": ["frame_plank", "cargo_bed"], "L": ["axle_wood", "wheel_spoked", "iron_tyre", "frame_plank", "cargo_bed"], "R": ["wheel_spoked", "iron_tyre", "frame_plank", "cargo_bed"], "S": ["frame_plank", "seat_bench"], "h": ["shaft_pair"] },
