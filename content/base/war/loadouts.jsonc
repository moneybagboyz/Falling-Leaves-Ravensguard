// P7-SC-A (soldiers-and-companies 3.2, 4.2, 4.3): the loadout templates and the filling rule's numbers. A template is a list of slots in fill order; a slot lists the item shapes it accepts. A required slot nothing
// fills is a gap; an optional one is shown greyed. `own` slots (a soldier's clothes, the gear his household sends with a levy) are filled only from what he already owns: an armoury is never asked for them (the
// armoury's furniture holds weapons, shields, helmets and body armour). Ammunition, horses, barding, saddles and stakes are counted goods or animals, not item rows, and are left to the armies spec.
[
  { "type": "soldier_rules", "id": "soldier_rules",
    "quality_score": 100, "condition_div": 10, "material_score": 50, "misfit_penalty": 300, "worn_bonus": 20, "fit_tolerance_pm": 150, "merc_wage_mult_pm": 1500,
    "material_rank": { "wool": 0, "linen": 0, "silk": 0, "oak": 0, "ash": 0, "bone": 0, "leather": 1, "bronze": 1, "copper": 1, "iron": 2, "wrought_iron": 2, "steel": 3 },
    "refit_shrink_only": ["plate"], "middling_mites": 20000, "well_off_mites": 100000, "levy_lord_fill": "levy_lord_fill",
    "fight_dx100": 100, "fight_uses_per_fight": 18, "drill_dx100": 40, "drill_cap": 40, "drill_shield_cap": 35, "drill_uses_per_hour": 8, "drill_hours_day": 2,
    "spar_dx100": 100, "spar_margin": 5, "spar_max_level": 60, "spar_uses_per_hour": 12,
    "formation_hour_gain": 20, "formation_day_loss": 5, "close_ranks_base_ticks": 40, "close_ranks_drill_div": 25,
    "retinue_caps": { "manor": 6, "knights_fee": 12, "baron": 40, "count": 120, "ruler": 300 } },

  // ---- levies: what the household sends, by wealth (4.3), and what the lord's armoury adds by default ----
  { "type": "loadout_template", "id": "levy_poor", "name": "Levy, poor household",
    "slots": [ { "slot": "weapon", "accept": ["hand_axe", "axe", "billhook", "flail", "club", "dagger"], "own": true },
               { "slot": "over", "accept": ["tunic"], "own": true } ] },
  { "type": "loadout_template", "id": "levy_middling", "name": "Levy, middling household",
    "slots": [ { "slot": "weapon", "accept": ["spear"], "own": true },
               { "slot": "alt_weapon", "accept": ["hand_axe", "axe", "billhook", "flail", "club", "dagger"], "own": true },
               { "slot": "shield", "accept": ["round_shield"], "own": true },
               { "slot": "helmet", "accept": ["kettle_hat", "cap", "padded_coif"], "own": true },
               { "slot": "over", "accept": ["gambeson", "jack", "doublet", "tunic"], "own": true } ] },
  { "type": "loadout_template", "id": "levy_well_off", "name": "Levy, well-off household",
    "slots": [ { "slot": "weapon", "accept": ["arming_sword", "axe", "spear", "hand_axe", "billhook", "flail", "club", "dagger"], "own": true },
               { "slot": "alt_weapon", "accept": ["spear", "arming_sword", "axe", "hand_axe", "billhook", "flail", "club", "dagger"], "own": true },
               { "slot": "shield", "accept": ["round_shield", "heater"], "own": true },
               { "slot": "helmet", "accept": ["kettle_hat", "nasal_helm", "spangenhelm", "helm", "cap"], "own": true },
               { "slot": "armour", "accept": ["mail_hauberk", "scale_hauberk", "jack"], "own": true },
               { "slot": "over", "accept": ["gambeson", "jack", "doublet", "tunic"], "own": true } ] },
  { "type": "loadout_template", "id": "levy_lord_fill", "name": "Levy, filled from the lord's armoury",
    "slots": [ { "slot": "weapon", "accept": ["spear"] }, { "slot": "shield", "accept": ["round_shield"] } ] },

  // ---- the professionals (filled from their lord's armoury by 4.2) ----
  { "type": "loadout_template", "id": "spearman", "name": "Spearman",
    "slots": [ { "slot": "weapon", "accept": ["spear", "billhook", "pike"], "min_quality": "poor", "min_material": ["iron", "wrought_iron", "steel"], "required": true },
               { "slot": "shield", "accept": ["round_shield", "heater"], "required": true },
               { "slot": "helmet", "accept": ["kettle_hat", "nasal_helm", "spangenhelm", "helm"], "required": true },
               { "slot": "armour", "accept": ["mail_hauberk", "scale_hauberk"] },
               { "slot": "over", "accept": ["gambeson", "jack"], "own": true },
               { "slot": "under", "accept": ["shirt"], "own": true },
               { "slot": "cover", "accept": ["cloak"], "own": true } ] },
  { "type": "loadout_template", "id": "archer", "name": "Archer",
    "slots": [ { "slot": "launcher", "accept": ["longbow"], "required": true },
               { "slot": "weapon", "accept": ["arming_sword", "hand_axe", "axe", "dagger"], "required": true },
               { "slot": "helmet", "accept": ["kettle_hat", "nasal_helm", "spangenhelm"] },
               { "slot": "over", "accept": ["gambeson", "jack"], "own": true } ] },
  { "type": "loadout_template", "id": "crossbowman", "name": "Crossbowman",
    "slots": [ { "slot": "launcher", "accept": ["crossbow"], "required": true },
               { "slot": "weapon", "accept": ["arming_sword", "hand_axe", "dagger"], "required": true },
               { "slot": "shield", "accept": ["buckler"] },
               { "slot": "helmet", "accept": ["kettle_hat", "nasal_helm", "spangenhelm"], "required": true },
               { "slot": "over", "accept": ["gambeson", "jack"], "own": true } ] },
  { "type": "loadout_template", "id": "light_horse", "name": "Light horse",
    "slots": [ { "slot": "weapon", "accept": ["arming_sword", "axe", "mace", "spear"], "required": true },
               { "slot": "alt_weapon", "accept": ["spear", "javelin", "hand_axe"] },
               { "slot": "shield", "accept": ["heater", "round_shield", "buckler"], "required": true },
               { "slot": "helmet", "accept": ["kettle_hat", "nasal_helm", "spangenhelm", "helm"], "required": true },
               { "slot": "armour", "accept": ["mail_hauberk", "scale_hauberk", "brigandine"] },
               { "slot": "over", "accept": ["gambeson", "jack"], "own": true } ] },
  { "type": "loadout_template", "id": "man_at_arms", "name": "Man-at-arms",
    "slots": [ { "slot": "weapon", "accept": ["arming_sword", "axe", "mace", "war_hammer"], "min_quality": "common", "min_material": ["iron", "wrought_iron", "steel"], "required": true },
               { "slot": "shield", "accept": ["heater", "round_shield"], "required": true },
               { "slot": "helmet", "accept": ["helm", "kettle_hat", "nasal_helm", "spangenhelm"], "required": true },
               { "slot": "armour", "accept": ["mail_hauberk", "scale_hauberk", "brigandine", "lamellar"], "required": true },
               { "slot": "legs", "accept": ["mail_chausses", "greaves", "cuisses"] },
               { "slot": "hands", "accept": ["gauntlets"] },
               { "slot": "over", "accept": ["gambeson", "jack"], "own": true },
               { "slot": "cover", "accept": ["surcoat", "cloak"], "own": true } ] },
  { "type": "loadout_template", "id": "knight", "name": "Knight",
    "slots": [ { "slot": "weapon", "accept": ["arming_sword", "longsword", "mace", "war_hammer", "axe"], "min_quality": "common", "min_material": ["steel", "iron", "wrought_iron"], "required": true },
               { "slot": "alt_weapon", "accept": ["lance"] },
               { "slot": "shield", "accept": ["heater"], "required": true },
               { "slot": "helmet", "accept": ["great_helm", "helm", "kettle_hat"], "required": true },
               { "slot": "armour", "accept": ["mail_hauberk", "brigandine", "scale_hauberk"], "required": true },
               { "slot": "plate", "accept": ["breastplate", "backplate"] },
               { "slot": "legs", "accept": ["mail_chausses", "greaves", "cuisses"] },
               { "slot": "hands", "accept": ["gauntlets"] },
               { "slot": "over", "accept": ["gambeson", "jack"], "own": true },
               { "slot": "cover", "accept": ["surcoat", "tabard", "cloak"], "own": true } ] },
  { "type": "loadout_template", "id": "engineer", "name": "Engineer",
    "slots": [ { "slot": "weapon", "accept": ["hand_axe", "axe", "dagger", "mace"], "required": true },
               { "slot": "helmet", "accept": ["cap", "kettle_hat"] },
               { "slot": "over", "accept": ["tunic", "gambeson"], "own": true } ] },
  { "type": "loadout_template", "id": "sailor", "name": "Sailor",
    "slots": [ { "slot": "weapon", "accept": ["dagger", "hand_axe", "club"] }, { "slot": "over", "accept": ["tunic"], "own": true } ] },
  { "type": "loadout_template", "id": "marine", "name": "Marine",
    "slots": [ { "slot": "weapon", "accept": ["arming_sword", "axe", "spear"], "required": true },
               { "slot": "shield", "accept": ["round_shield", "buckler"], "required": true },
               { "slot": "helmet", "accept": ["kettle_hat", "nasal_helm", "spangenhelm"] },
               { "slot": "over", "accept": ["gambeson", "jack"], "own": true } ] }
]
