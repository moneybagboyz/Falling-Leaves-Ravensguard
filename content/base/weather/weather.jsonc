// Weather tunables (plan §3c). Arrays are [spring, summer, autumn, winter]. Percentages and permille are integers; temperatures in tenths of a degree C.
[
  {
    "type": "weather_settings", "id": "weather_defaults",
    "latitude_north_tenths": 660, "latitude_south_tenths": 300,   // north edge of the continent / south edge; mid-continent ~48 N gives ~16 h / ~8 h days
    "seasonal_amp_base_tenths": 70, "seasonal_amp_north_extra_tenths": 70,  // seasonal swing: 7 C in the south, 14 C in the north
    "daily_amp_tenths": 60, "synoptic_amp_tenths": 25,
    "heatwave_tenths": 300, "snow_below_tenths": 10,
    "front_count_min": [4, 3, 4, 5], "front_count_max": [7, 6, 7, 8],   // fronts spawned per 15-day season
    "cold_front_pct": [40, 30, 45, 55], "front_strength_pct": [95, 70, 100, 110],
    "front_speed_min_cells_day": 16, "front_speed_max_cells_day": 30,   // 2 km cells per day, moving west to east
    "drought_permille_year": 70, "wet_year_permille_year": 70, "cold_summer_permille_year": 60,
    "heavy_rain_mm_h_tenths": 25, "heavy_day_mm": 12, "ford_closed_days": 3, "ford_recede_days": 2,
    "biomes": [
      { "biome": "Desert", "rain_scale_pct": 55, "season_rain_pct": [110, 60, 90, 140], "cloud_bias_permille": [-150, -200, -150, -100], "fog_day_pct": [4, 3, 6, 6], "thunder_pct": [6, 25, 4, 0] },
