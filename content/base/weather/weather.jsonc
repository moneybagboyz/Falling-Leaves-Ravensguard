      { "biome": "Grassland", "rain_scale_pct": 100, "season_rain_pct": [110, 95, 105, 90], "cloud_bias_permille": [0, -20, 20, 40], "fog_day_pct": [20, 15, 35, 28], "thunder_pct": [10, 30, 8, 0] },
      { "biome": "TemperateForest", "rain_scale_pct": 100, "season_rain_pct": [105, 90, 115, 100], "cloud_bias_permille": [30, 0, 50, 70], "fog_day_pct": [28, 20, 45, 35], "thunder_pct": [10, 28, 8, 0] },
      { "biome": "Taiga", "rain_scale_pct": 90, "season_rain_pct": [90, 115, 105, 90], "cloud_bias_permille": [40, 20, 70, 90], "fog_day_pct": [22, 20, 35, 25], "thunder_pct": [4, 18, 3, 0] },
