      { "biome": "Marsh", "rain_scale_pct": 110, "season_rain_pct": [100, 100, 110, 90], "cloud_bias_permille": [40, 20, 60, 60], "fog_day_pct": [50, 38, 65, 50], "thunder_pct": [8, 25, 6, 0] },
