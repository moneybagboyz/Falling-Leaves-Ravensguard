; Engine configuration file.
config_version=5

[application]
config/name="Falling Leaves: Ravensguard"
run/main_scene="res://scenes/App.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="disabled"

[dotnet]
project/assembly_name="Ravensguard.Game"

[rendering]

environment/defaults/default_clear_color=Color(0.0784314, 0.0666667, 0.0941176, 1)
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0

[internationalization]

locale/translations=PackedStringArray("res://localization/en.en.translation")
