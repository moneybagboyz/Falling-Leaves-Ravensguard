<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- the behaviour content ships inside the assembly as the default, so the pure schedule functions need no content folder; a loaded ContentDatabase overrides it -->
    <EmbeddedResource Include="..\..\content\base\behaviour\*.jsonc" LogicalName="behaviour/%(Filename)%(Extension)" />
    <!-- the talk content (lines, barks, authored dialogue, rumour types) likewise -->
    <EmbeddedResource Include="..\..\content\base\dialogue\**\*.jsonc" LogicalName="dialogue/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- the autopilot content (activities, settings) likewise -->
    <EmbeddedResource Include="..\..\content\base\autopilot\*.jsonc" LogicalName="autopilot/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ravensguard.Content\Ravensguard.Content.csproj" />
  </ItemGroup>

</Project>
